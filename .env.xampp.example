CI_ENVIRONMENT = development

app.baseURL = 'http://localhost/JNG-Apply-Portal-v3.0/public/'
app.forceGlobalSecureRequests = false

# Shared JNG Careers database
database.default.hostname = localhost
database.default.database = jng_careers
database.default.username = root
database.default.password = ''
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# Leave storagePath unset to use writable/careers-storage locally.
# In production, use the same protected storage used by Recruitment Hub.
# careers.storagePath = 'D:/JNGShared/careers-storage'
careers.websiteURL = 'http://localhost:3000/'
careers.rememberDays = 30
careers.resetMinutes = 60

careers.table.applicants = applicants
careers.table.jobs = job
careers.table.jobPosts = job_list
careers.table.applications = job_applications
careers.table.applicationHistories = application_histories
careers.table.education = applicant_education
careers.table.employment = applicant_job_history
careers.table.documents = applicant_document_attachments
careers.table.tokens = applicant_tokens
careers.table.passwordResets = applicant_password_resets
careers.table.notifications = applicant_notifications
careers.table.statuses = status
careers.table.departments = departments
careers.table.companies = companies

careers.publicJobStatuses = 'Published,Open,Active'
careers.initialApplicationStatuses = 'Submitted,Applied,New'

# JNG Mailer API
careersMailer.endpoint = 'https://jn-mailer-staging.joy-nostalg.com/send/careers'
careersMailer.authHeader = Authorization
careersMailer.authorization = change-this-api-key
# Use Bearer only when the mailer endpoint requires it. Leave empty for a raw key.
careersMailer.authPrefix =
careersMailer.timeout = 30

session.cookieName = jng_apply_session
session.expiration = 7200
# Do not set session.savePath to WRITEPATH/session in .env.
# PHP constants are not evaluated in environment values.

cookie.secure = false
cookie.httponly = true
cookie.samesite = Lax
